# Optional: Gemini API Key for Emerald AI Assistant (Gemini Flash free tier)
# Get your key from aistudio.google.com -> "Get API key"
# If omitted, Emerald will run in Basic Mode (contextual template engine)
GEMINI_API_KEY=your-key-here
